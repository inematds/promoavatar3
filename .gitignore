# Artefatos e mídia: grandes e regeneráveis. O rastro fica no estado do bot
# (tabelas de fluxo) e nos textos versionados.
output/
*.mp4
*.log

# Exceção: o CTA não é artefato regenerável, é ativo fixo do domínio (~60 KB) e
# a instalação quebra sem ele.
!cta/*.mp4

# Bytecode do Python: lixo binário, e traz caminho absoluto embutido.
__pycache__/
*.pyc
